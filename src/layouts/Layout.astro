---
import { getLangFromUrl, useTranslations } from '../i18n/utils'
import { Font } from 'astro:assets'
import Loader from '../components/Loader.astro'

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

export interface Props {
  noIndex?: boolean
  /** Page-specific title; defaults to the site title. */
  title?: string
  /** Page-specific meta/social description; defaults to the site description. */
  description?: string
  /** Path of a 1200x630 social preview image, relative to the site root. */
  ogImage?: string
  ogType?: 'website' | 'article'
}

const {
  noIndex,
  title = t('site.title') as string,
  description = t('site.metaDescription') as string,
  ogImage: ogImagePath = '/og/home.png',
  ogType = 'website',
} = Astro.props

// Social preview metadata. Absolute URLs are required by the scrapers, so
// everything is resolved against `site` in astro.config.mjs.
const siteUrl = Astro.site ?? new URL('https://eliotbas.com')
const pageUrl = new URL(Astro.url.pathname, siteUrl)
const ogImage = new URL(ogImagePath, siteUrl)
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Eliot Bas" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl.href} />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Eliot Bas — software engineer, based in Montréal"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage.href} />
    {noIndex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <Font cssVariable="--font-body" preload />
    <Font cssVariable="--font-heading" preload />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <Loader />
    <slot />
  </body>
</html>

<style lang="scss" is:global>
  :root {
    --secondary: #d2d4ff;
    --accent: #585efb;
    --black: #121212;
    --gray: #e6e6f0;
    --white: #fafafa;
    --text: var(--black);
    --background: var(--white);
    --nav-background: var(--white);
    --highlight: var(--secondary);
    --othello-gameboard-bg: #eaeaea;
    --radius: 18px;
    --theme-transition: 0.15s ease-out;
    &.dark-theme {
      --text: var(--white);
      --background: #02031d;
      --nav-background: #282870;
      --highlight: var(--accent);
      --othello-gameboard-bg: #1e1f33;
    }
  }
  // Only while the theme toggle is switching (ToggleThemeButton.astro): one fade for every colour,
  // overriding hover timings (0.2s, 0.3s…) and third-party styles such as the Botpress webchat, which
  // would otherwise switch instantly or lag behind. The toggle keeps its own sun/moon animation.
  html.theme-switching :not(.toggle-theme, .toggle-theme *),
  html.theme-switching :not(.toggle-theme, .toggle-theme *)::before,
  html.theme-switching :not(.toggle-theme, .toggle-theme *)::after {
    transition:
      color var(--theme-transition),
      background-color var(--theme-transition),
      border-color var(--theme-transition),
      outline-color var(--theme-transition),
      text-decoration-color var(--theme-transition),
      fill var(--theme-transition),
      stroke var(--theme-transition),
      stop-color var(--theme-transition),
      box-shadow var(--theme-transition),
      --gradient-color var(--theme-transition) !important;
  }
  // Inverted elements (label in the background colour on a fill in the text colour) would pass
  // through the same grey halfway through that fade, so the label vanishes for a moment. The fill
  // still fades; the label flips in one step a third of the way in, when the ease-out fill is
  // about halfway and the label reads on it either way.
  html.theme-switching :is(.theme-inverted, .vdk-edge-launcher, .vdk-edge-teaser-bubble),
  html.theme-switching :is(.theme-inverted, .vdk-edge-launcher, .vdk-edge-teaser-bubble) * {
    transition:
      background-color var(--theme-transition),
      border-color var(--theme-transition),
      box-shadow var(--theme-transition),
      color 0s 0.05s,
      fill 0s 0.05s,
      stroke 0s 0.05s !important;
  }
  // Colour used inside a gradient (TechnoBand edges, About highlight). Registered so it can be
  // transitioned: a gradient itself would swap instantly on a theme switch.
  @property --gradient-color {
    syntax: '<color>';
    inherits: false;
    initial-value: transparent;
  }
  html {
    font-family: var(--font-body);
    font-size: clamp(16px, calc(15px + 0.2vw), 20px);
    font-weight: 400;
    font-style: normal;
    background-color: var(--background);
    scroll-behavior: smooth;
    transition: background-color var(--theme-transition);
    -webkit-tap-highlight-color: transparent;
  }
  body {
    margin: 0;
    overflow-x: hidden;
    &.no-scroll {
      overflow: hidden;
    }
  }
  // :not(:where(...)) keeps the original specificity while leaving the Botpress webchat alone
  :is(h1, h2, h3, p, a, span):not(:where(.vdk-edge *)) {
    color: var(--text);
    transition: color var(--theme-transition);
  }
  :is(h1, h2, h3):not(:where(.vdk-edge *)) {
    font-family: var(--font-heading);
  }
  a:not(:where(.vdk-edge *)) {
    text-decoration: none;
    line-height: 0;
    outline-color: var(--accent);
  }
  button {
  }
  p:not(:where(.vdk-edge *)) {
    font-size: 1rem;
    margin: 0;
    transition: color var(--theme-transition);
  }
  * {
    box-sizing: border-box;
  }
</style>

<script>
  window.addEventListener('load', () => {
    console.clear()
    console.log(
      '%c BAS Eliot - Portfolio ',
      'color: #fafafa; background-color: #585efb; font-size: 30px; font-weight: 700'
    )
  })
</script>
