---
import { getLangFromUrl, useTranslations } from '../i18n/utils'
import Loader from '../components/Loader.astro'

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

export interface Props {
  noIndex?: boolean
}

const { noIndex } = Astro.props

// Social preview metadata. Absolute URLs are required by the scrapers, so
// everything is resolved against `site` in astro.config.mjs.
const siteUrl = Astro.site ?? new URL('https://eliotbas.com')
const pageUrl = new URL(Astro.url.pathname, siteUrl)
const ogImage = new URL('/og/home.png', siteUrl)
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={t('site.metaDescription') as string} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Eliot Bas" />
    <meta property="og:title" content={t('site.title') as string} />
    <meta
      property="og:description"
      content={t('site.metaDescription') as string}
    />
    <meta property="og:url" content={pageUrl.href} />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Eliot Bas — software engineer, based in Montréal"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={t('site.title') as string} />
    <meta
      name="twitter:description"
      content={t('site.metaDescription') as string}
    />
    <meta name="twitter:image" content={ogImage.href} />
    {noIndex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,200..800;1,200..800&family=Space+Grotesk:wght@300..700&display=swap" rel="stylesheet">
    <meta name="generator" content={Astro.generator} />
    <title>{t('site.title')}</title>
  </head>
  <body>
    <Loader />
    <slot />
  </body>
</html>

<style lang="scss" is:global>
  :root {
    --secondary: #d2d4ff;
    --accent: #585efb;
    --black: #121212;
    --gray: #e6e6f0;
    --white: #fafafa;
    --text: var(--black);
    --background: var(--white);
    --nav-background: var(--white);
    --highlight: var(--secondary);
    --othello-gameboard-bg: #eaeaea;
    --radius: 18px;
    --theme-transition: 0.15s ease-out;
    &.dark-theme {
      --text: var(--white);
      --background: #02031d;
      --nav-background: #282870;
      --highlight: var(--accent);
      --othello-gameboard-bg: #1e1f33;
    }
  }
  html {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: clamp(16px, calc(15px + 0.2vw), 20px);
    font-weight: 400;
    font-style: normal;
    background-color: var(--background);
    scroll-behavior: smooth;
    transition: background-color var(--theme-transition);
    -webkit-tap-highlight-color: transparent;
  }
  body {
    margin: 0;
    overflow-x: hidden;
    &.no-scroll {
      overflow: hidden;
    }
  }
  // :not(:where(...)) keeps the original specificity while leaving the Botpress webchat alone
  :is(h1, h2, h3, p, a, span):not(:where(.vdk-edge *)) {
    color: var(--text);
    transition: color var(--theme-transition);
  }
  :is(h1, h2, h3):not(:where(.vdk-edge *)) {
    font-family: 'Space Grotesk', sans-serif;
  }
  a:not(:where(.vdk-edge *)) {
    text-decoration: none;
    line-height: 0;
    outline-color: var(--accent);
  }
  button {
  }
  p:not(:where(.vdk-edge *)) {
    font-size: 1rem;
    margin: 0;
    transition: color var(--theme-transition);
  }
  * {
    box-sizing: border-box;
  }
</style>

<script>
  window.addEventListener('load', () => {
    console.clear()
    console.log(
      '%c BAS Eliot - Portfolio ',
      'color: #fafafa; background-color: #585efb; font-size: 30px; font-weight: 700'
    )
  })
</script>
