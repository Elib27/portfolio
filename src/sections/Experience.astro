---
import { getLangFromUrl, useTranslations } from '../i18n/utils'
import SectionLayout from '../layouts/SectionLayout.astro'
import botpressMark from '../assets/companies/botpress-mark.svg'
import koesioMark from '../assets/companies/koesio-mark.svg'
import upflowMark from '../assets/companies/upflow-mark.svg'
import freelanceMark from '../assets/companies/freelance-mark.svg'

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

interface Role {
  company: string
  logo: string
  url?: string
  location: string
  title: string
  dates: string
  // One line on what the company does, for readers who haven't heard of it
  summary?: string
  badge?: keyof typeof badges
  /** Stack used in the role, shown as chips under the bullets. Optional: roles without it render no chips. */
  tags?: string[]
  bullets: string[]
}

// Short chip after the company name; the full name is read out and shown on hover
const badges = {
  yc: { short: 'YC', full: 'Y Combinator W20' },
}

// Each mark is sized so they read as the same size inside the chip rather than sharing a bounding box.
// The solid Botpress tile sits a little smaller than the open Koesio and Upflow letterforms, but not so
// small that it reads as a box inside a box.
const logos: Record<string, { src: ImageMetadata; w: number; h: number }> = {
  botpress: { src: botpressMark, w: 66, h: 66 },
  koesio: { src: koesioMark, w: 48.1, h: 68.4 },
  upflow: { src: upflowMark, w: 69, h: 52.9 },
  freelance: { src: freelanceMark, w: 61.8, h: 61.8 },
}

const roles = t('experience.roles') as unknown as Role[]
---

<SectionLayout title={t('experience.title') as string} id="experience">
  <ol class="timeline">
    {
      roles.map((role) => (
        <li class="role">
          <span class="logo">
            <img
              src={logos[role.logo].src.src}
              alt=""
              style={`width:${logos[role.logo].w}%;height:${logos[role.logo].h}%`}
            />
          </span>
          <h3>
            {role.url ? (
              <a href={role.url} target="_blank" rel="noopener noreferrer">
                {role.company}
              </a>
            ) : (
              role.company
            )}
            {role.badge && (
              <span class="badge" title={badges[role.badge].full}>
                <span aria-hidden="true">{badges[role.badge].short}</span>
                <span class="sr-only">({badges[role.badge].full})</span>
              </span>
            )}
          </h3>
          <span class="job-title">{role.title}</span>
          <span class="meta">
            <span>{role.dates}</span>
            <span class="location">{role.location}</span>
          </span>
          {role.summary && <p class="summary">{role.summary}</p>}
          <ul class="points">
            {role.bullets.map((bullet) => (
              <li set:html={bullet} />
            ))}
          </ul>
          {role.tags && role.tags.length > 0 && (
            <ul class="tags">
              {role.tags.map((tag) => (
                <li>{tag}</li>
              ))}
            </ul>
          )}
        </li>
      ))
    }
  </ol>
</SectionLayout>

<style lang="scss">
  .timeline {
    // ~75 characters per line in the bullet column
    width: min(80%, 760px);
    margin: auto;
    list-style: none;
    padding: 0;
  }

  .role {
    --logo-size: 44px;
    // nudges the chip onto the optical centre of the two-line company/role header
    --logo-top: 0.15rem;
    --logo-center: calc(var(--logo-top) + var(--logo-size) / 2);
    --gutter: 1.25rem;
    --rail: color-mix(in srgb, var(--accent) 28%, transparent);
    position: relative;
    display: grid;
    grid-template-columns: var(--logo-size) minmax(0, 1fr) auto;
    grid-template-areas:
      'logo company meta'
      'logo title   title'
      '.    summary summary'
      '.    points  points'
      '.    tags    tags';
    column-gap: var(--gutter);
    align-items: baseline;
    padding-bottom: 3rem;

    // the indigo tint fades into the navy background, so it needs more weight there
    :global(.dark-theme) & {
      --rail: color-mix(in srgb, var(--accent) 50%, transparent);
    }

    &:last-child {
      padding-bottom: 0;
    }

    // Rail: one continuous line from this chip's centre to the next one's, drawn behind the chips
    &::before {
      content: '';
      position: absolute;
      left: calc(var(--logo-size) / 2 - 1px);
      top: var(--logo-center);
      bottom: calc(-1 * var(--logo-center));
      width: 2px;
      border-radius: 1px;
      background-color: var(--rail);
      transition: background-color var(--theme-transition);
    }

    &:last-child::before {
      display: none;
    }
  }

  .logo {
    grid-area: logo;
    align-self: start;
    position: relative;
    z-index: 1;
    margin-top: var(--logo-top);
    height: var(--logo-size);
    width: var(--logo-size);
    border-radius: 12px;
    background-color: var(--white);
    border: 1px solid color-mix(in srgb, var(--text) 10%, transparent);
    // the background-coloured ring opens a small gap where the rail meets the chip
    box-shadow:
      0 0 0 6px var(--background),
      0 1px 3px color-mix(in srgb, var(--black) 8%, transparent);
    display: flex;
    align-items: center;
    justify-content: center;
    transition:
      border-color 0.2s ease,
      box-shadow var(--theme-transition);

    img {
      display: block;
    }
  }

  .role:hover .logo {
    border-color: color-mix(in srgb, var(--accent) 45%, transparent);
  }

  h3 {
    grid-area: company;
    font-size: 1.2rem;
    line-height: 1.3;
    margin: 0;

    a {
      line-height: inherit;
      // not inherit: that makes the link lag behind the heading during a theme switch (see About.astro)
      color: var(--text);
      text-decoration: underline;
      text-underline-offset: 3px;
      text-decoration-thickness: 1px;
      text-decoration-color: color-mix(in srgb, var(--text) 30%, transparent);
      transition: text-decoration-color 0.2s ease;

      &:hover {
        text-decoration-color: var(--accent);
      }
    }
  }

  .badge {
    display: inline-flex;
    align-items: center;
    margin-left: 0.5em;
    padding: 0.15em 0.4em;
    border-radius: 4px;
    // YC orange, with white text that stays readable in both themes
    background-color: #f26522;
    color: #fff;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    line-height: 1.2;
    vertical-align: 0.2em;
    cursor: default;

    // the global span rule would otherwise paint the label in the text colour
    span {
      color: inherit;
    }
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .summary {
    grid-area: summary;
    margin: 0.6rem 0 0;
    font-size: 0.9rem;
    font-style: italic;
    line-height: 1.5;
    color: color-mix(in srgb, var(--text) 65%, transparent);
    transition: color var(--theme-transition);
  }

  .job-title {
    grid-area: title;
    margin-top: 0.15rem;
    font-size: 0.95rem;
    font-weight: 500;
    color: color-mix(in srgb, var(--text) 75%, transparent);
    transition: color var(--theme-transition);
  }

  .meta {
    grid-area: meta;
    // flex drops the source whitespace between the two spans, so the dot spacing stays even
    display: flex;
    flex-wrap: wrap;
    column-gap: 0.45em;
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;

    span {
      color: color-mix(in srgb, var(--text) 68%, transparent);
    }

    .location::before {
      content: '·';
      margin-right: 0.45em;
    }
  }

  .points {
    grid-area: points;
    list-style: none;
    padding: 0;
    margin: 0.9rem 0 0;

    li {
      --marker: 5px;
      position: relative;
      margin-bottom: 0.6rem;
      font-size: 0.95rem;
      line-height: 1.6;
      color: var(--text);
      transition: color var(--theme-transition);

      &:last-child {
        margin-bottom: 0;
      }

      // Bullets are injected as HTML, so their links need :global to pick up these styles
      :global(a) {
        color: var(--text);
        text-decoration: underline;
        text-underline-offset: 3px;
        text-decoration-thickness: 1px;
        text-decoration-color: var(--accent);
        transition: color 0.2s ease;

        &:hover {
          color: var(--accent);
        }
      }

      // Hanging marker: sits in the gutter so the bullet text lines up with the company name
      &::before {
        content: '';
        position: absolute;
        left: calc(-1 * var(--gutter) / 2 - var(--marker) / 2);
        top: calc(0.8em - var(--marker) / 2);
        width: var(--marker);
        height: var(--marker);
        border-radius: 50%;
        background-color: var(--accent);
        transition: background-color var(--theme-transition);
      }
    }
  }

  // Same chip style as the project cards' technology list
  .tags {
    grid-area: tags;
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin: 0.9rem 0 0;
    padding: 0;
    list-style: none;

    li {
      font-size: 0.8rem;
      font-weight: 500;
      white-space: nowrap;
      padding: 0.2rem 0.65rem;
      border-radius: 999px;
      color: color-mix(in srgb, var(--text) 80%, transparent);
      border: 1px solid color-mix(in srgb, var(--text) 22%, transparent);
      transition:
        color var(--theme-transition),
        border-color var(--theme-transition);
    }
  }

  @media (max-width: 768px) {
    .timeline {
      width: 90%;
    }
  }

  // Phone: the logo sits beside a three-line header and the bullets take the full width,
  // so the rail has nothing to connect and is dropped.
  @media (max-width: 600px) {
    .timeline {
      width: 100%;
    }

    .role {
      --logo-size: 40px;
      grid-template-columns: var(--logo-size) minmax(0, 1fr);
      grid-template-areas:
        'logo   company'
        'logo   title'
        'logo   meta'
        'summary summary'
        'points points'
        'tags   tags';
      column-gap: 0.85rem;
      align-items: start;
      padding-bottom: 2.5rem;

      &::before {
        display: none;
      }
    }

    .logo {
      align-self: center;
      margin-top: 0;
      box-shadow: 0 1px 3px color-mix(in srgb, var(--black) 8%, transparent);
    }

    .job-title {
      margin-top: 0.1rem;
    }

    .meta {
      margin-top: 0.1rem;
      white-space: normal;
    }

    // no gutter to hang into here, so the marker moves back inside the text block
    .points li {
      padding-left: 1rem;

      &::before {
        left: 0.1rem;
      }
    }
  }
</style>
