---
import { getLangFromUrl, useTranslations } from '../i18n/utils'
import SectionLayout from '../layouts/SectionLayout.astro'
import botpressMark from '../assets/companies/botpress-mark.svg'
import koesioMark from '../assets/companies/koesio-mark.svg'
import upflowMark from '../assets/companies/upflow-mark.svg'
import freelanceMark from '../assets/companies/freelance-mark.svg'

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

interface Role {
  company: string
  logo: string
  url?: string
  location: string
  title: string
  dates: string
  /** Stack used in the role, shown as chips under the bullets. Optional: roles without it render no chips. */
  tags?: string[]
  bullets: string[]
}

// Each mark is sized so they read as the same size inside the chip rather than sharing a bounding box.
// The solid Botpress tile sits a little smaller than the open Koesio and Upflow letterforms, but not so
// small that it reads as a box inside a box.
const logos: Record<string, { src: ImageMetadata; w: number; h: number }> = {
  botpress: { src: botpressMark, w: 66, h: 66 },
  koesio: { src: koesioMark, w: 48.1, h: 68.4 },
  upflow: { src: upflowMark, w: 69, h: 52.9 },
  freelance: { src: freelanceMark, w: 61.8, h: 61.8 },
}

const roles = t('experience.roles') as unknown as Role[]
---

<SectionLayout title={t('experience.title') as string} id="experience">
  <ol class="timeline">
    {
      roles.map((role) => (
        <li class="role">
          <span class="logo">
            <img
              src={logos[role.logo].src.src}
              alt=""
              style={`width:${logos[role.logo].w}%;height:${logos[role.logo].h}%`}
            />
          </span>
          <h3>
            {role.url ? (
              <a href={role.url} target="_blank" rel="noopener noreferrer">
                {role.company}
              </a>
            ) : (
              role.company
            )}
          </h3>
          <span class="job-title">{role.title}</span>
          <span class="meta">
            <span>{role.dates}</span>
            <span class="location">{role.location}</span>
          </span>
          <ul class="points">
            {role.bullets.map((bullet) => (
              <li set:html={bullet} />
            ))}
          </ul>
          {role.tags && role.tags.length > 0 && (
            <ul class="tags">
              {role.tags.map((tag) => (
                <li>{tag}</li>
              ))}
            </ul>
          )}
        </li>
      ))
    }
  </ol>
</SectionLayout>

<style lang="scss">
  .timeline {
    width: min(80%, 800px);
    margin: auto;
    list-style: none;
    padding: 0;
  }

  .role {
    --logo-size: 40px;
    // nudges the chip onto the optical centre of the two-line company/role header
    --logo-top: 0.3rem;
    position: relative;
    display: grid;
    grid-template-columns: var(--logo-size) minmax(0, 1fr) auto;
    grid-template-areas:
      'logo company meta'
      'logo title   title'
      '.    points  points'
      '.    tags    tags';
    column-gap: 1.1rem;
    align-items: baseline;
    padding-bottom: 2.75rem;

    &:last-child {
      padding-bottom: 0;
    }

    // Rail, running from just under the logo to the next one
    &::before {
      content: '';
      position: absolute;
      left: calc(var(--logo-size) / 2);
      top: calc(var(--logo-top) + var(--logo-size) + 0.5rem);
      bottom: 0;
      width: 1px;
      background-color: color-mix(in srgb, var(--text) 15%, transparent);
      transition: background-color var(--theme-transition);
    }

    &:last-child::before {
      display: none;
    }
  }

  .logo {
    grid-area: logo;
    align-self: start;
    margin-top: var(--logo-top);
    height: var(--logo-size);
    width: var(--logo-size);
    border-radius: 11px;
    background-color: var(--white);
    border: 1px solid color-mix(in srgb, var(--text) 10%, transparent);
    display: flex;
    align-items: center;
    justify-content: center;

    img {
      display: block;
    }
  }

  h3 {
    grid-area: company;
    font-size: 1.15rem;
    margin: 0;

    a {
      line-height: inherit;
      color: inherit;
      text-decoration: underline;
      text-underline-offset: 3px;
      text-decoration-thickness: 1px;
      text-decoration-color: color-mix(in srgb, var(--text) 30%, transparent);
      transition: text-decoration-color 0.2s ease;

      &:hover {
        text-decoration-color: var(--accent);
      }
    }
  }

  .job-title {
    grid-area: title;
    margin-top: 0.2rem;
    font-size: 0.9rem;
    font-weight: 500;
    color: color-mix(in srgb, var(--text) 72%, transparent);
    transition: color var(--theme-transition);
  }

  .meta {
    grid-area: meta;
    // flex drops the source whitespace between the two spans, so the dot spacing stays even
    display: flex;
    flex-wrap: wrap;
    column-gap: 0.45em;
    font-size: 0.875rem;
    opacity: 0.6;
    white-space: nowrap;

    .location::before {
      content: '·';
      margin-right: 0.45em;
    }
  }

  .points {
    grid-area: points;
    list-style: none;
    padding: 0;
    margin: 0.85rem 0 0;

    li {
      position: relative;
      padding-left: 1.1rem;
      margin-bottom: 0.5rem;
      font-size: 0.95rem;
      line-height: 1.55;
      color: var(--text);
      transition: color var(--theme-transition);

      &:last-child {
        margin-bottom: 0;
      }

      &::before {
        content: '•';
        position: absolute;
        left: 0;
        color: var(--accent);
        transition: color var(--theme-transition);
      }
    }
  }

  // Same chip style as the project cards' technology list
  .tags {
    grid-area: tags;
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin: 0.9rem 0 0;
    padding: 0;
    list-style: none;

    li {
      font-size: 0.8rem;
      font-weight: 500;
      white-space: nowrap;
      padding: 0.2rem 0.65rem;
      border-radius: 999px;
      color: color-mix(in srgb, var(--text) 80%, transparent);
      border: 1px solid color-mix(in srgb, var(--text) 22%, transparent);
      transition:
        color var(--theme-transition),
        border-color var(--theme-transition);
    }
  }

  @media (max-width: 768px) {
    .timeline {
      width: 90%;
    }
  }

  // Phone: the logo sits beside a three-line header and the bullets take the full width,
  // so the rail has nothing to connect and is dropped.
  @media (max-width: 600px) {
    .timeline {
      width: 100%;
    }

    .role {
      grid-template-columns: var(--logo-size) minmax(0, 1fr);
      grid-template-areas:
        'logo   company'
        'logo   title'
        'logo   meta'
        'points points'
        'tags   tags';
      column-gap: 0.85rem;
      align-items: start;
      padding-bottom: 2.25rem;

      &::before {
        display: none;
      }
    }

    .logo {
      align-self: center;
      margin-top: 0;
    }

    .job-title {
      margin-top: 0.1rem;
    }

    .meta {
      white-space: normal;
    }
  }
</style>
