<script is:inline>
  // Waits for "load" so a slow Botpress host never delays the loader or other load handlers
  window.addEventListener("load", () => {
    const baseUrl = "https://vdk-viber-runtime-prod.bot.botpress.host"
    const botId = "042840fa-e266-461f-be2a-4900e16c1ef7"
    // Injected from JS so the Botpress files never block parsing or rendering
    const inject = (tag, attrs) =>
      new Promise((resolve, reject) => {
        const el = Object.assign(document.createElement(tag), attrs, { onload: resolve, onerror: reject })
        document.head.appendChild(el)
      })
    Promise.all([
      fetch(`${baseUrl}/edge/bots/${botId}/config`).then((res) => res.json()),
      inject("script", { src: `${baseUrl}/edge/webchat.js` }),
      inject("link", { rel: "stylesheet", href: `${baseUrl}/edge/webchat.css` }),
    ])
      .then(([{ webchat }]) => {
        // follow the site's theme toggle (.dark-theme on <html>) instead of the OS preference
        const siteTheme = () => (document.documentElement.classList.contains("dark-theme") ? "dark" : "light")
        // the self-hosted font family names are hashed by Astro, so read them from the CSS variable
        const fontFamily = getComputedStyle(document.documentElement).getPropertyValue("--font-body").trim() || "sans-serif"
        VdkEdgeWebchat.mount({ ...webchat, theme: siteTheme(), fontFamily, mode: "bubble", baseUrl, botId })
        // the accent is set inline at mount, so swap it here: the site's black on light, white on dark
        const applyTheme = () => {
          const dark = siteTheme() === "dark"
          const [accent, contrast] = dark ? ["var(--white)", "var(--black)"] : ["var(--black)", "var(--white)"]
          document.querySelectorAll(".vdk-edge").forEach((el) => {
            el.classList.toggle("vdk-edge-dark", dark)
            el.classList.toggle("vdk-edge-light", !dark)
            el.classList.toggle("vdk-edge-bright-accent", dark)
            el.style.setProperty("--vdk-accent", accent)
            el.style.setProperty("--vdk-accent-contrast", contrast)
            el.style.setProperty("--vdk-accent-icon", contrast)
          })
        }
        applyTheme()
        new MutationObserver(applyTheme).observe(document.documentElement, { attributes: true, attributeFilter: ["class"] })

        // hide the greeting bubble while the Contact section is on screen: it would cover the
        // social links on phones and compete with the email. It comes back when scrolling up.
        const contact = document.getElementById("contact")
        if (contact) {
          new IntersectionObserver(([entry]) => {
            document.querySelectorAll(".vdk-edge").forEach((el) => el.classList.toggle("chat-near-contact", entry.isIntersecting))
          }, { threshold: 0.15 }).observe(contact)
        }

        // entrance: keep the launcher hidden while the loader is up, then play it once (the class is
        // removed afterwards, otherwise it would replay every time the chat is closed)
        const roots = document.querySelectorAll(".vdk-edge")
        roots.forEach((el) => el.classList.add("chat-waiting"))
        const enter = () =>
          roots.forEach((el) => {
            const done = (e) => {
              if (!e.animationName.startsWith("chat-launcher-")) return // enter, or fade with reduced motion
              el.classList.remove("chat-entering")
              el.removeEventListener("animationend", done)
            }
            el.addEventListener("animationend", done)
            el.classList.replace("chat-waiting", "chat-entering")
          })
        const loaderGone = () => !document.documentElement.classList.contains("show-loader")
        if (loaderGone()) enter()
        else {
          const observer = new MutationObserver(() => {
            if (!loaderGone()) return
            observer.disconnect()
            enter()
          })
          observer.observe(document.documentElement, { attributes: true, attributeFilter: ["class"] })
        }
      })
      .catch((err) => console.warn("Webchat failed to load", err))
  }, { once: true })
</script>

<style is:global>
  .vdk-edge.chat-waiting .vdk-edge-launcher {
    opacity: 0;
    pointer-events: none;
  }
  /* same easing as the hero entrance (HeaderHero.astro) */
  .vdk-edge.chat-entering .vdk-edge-launcher {
    animation: chat-launcher-enter 0.8s cubic-bezier(0, 0, 0.16, 1) 0.15s backwards;
  }
  .vdk-edge .vdk-edge-teaser {
    transition:
      opacity 0.25s ease,
      transform 0.25s ease;
  }
  .vdk-edge.chat-near-contact .vdk-edge-teaser {
    opacity: 0;
    transform: translateY(8px);
    pointer-events: none;
  }
  @keyframes chat-launcher-enter {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
  }
  @keyframes chat-launcher-fade {
    from {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .vdk-edge.chat-entering .vdk-edge-launcher {
      animation-name: chat-launcher-fade;
    }
    .vdk-edge.chat-near-contact .vdk-edge-teaser {
      transform: none;
    }
  }
</style>
