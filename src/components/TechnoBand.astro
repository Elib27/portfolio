---
// Decorative marquee between sections: two rows of words drifting in opposite directions around a
// row of single-colour tech logos. Each row is rendered twice so the -50% slide loops seamlessly.
// Logos live in src/assets/band-logos as currentColor SVGs (new ones from Simple Icons, CC0).
import anthropic from '../assets/band-logos/anthropic.svg?raw'
import astro from '../assets/band-logos/astro.svg?raw'
import c from '../assets/band-logos/c.svg?raw'
import docker from '../assets/band-logos/docker.svg?raw'
import git from '../assets/band-logos/git.svg?raw'
import graphql from '../assets/band-logos/graphql.svg?raw'
import huggingface from '../assets/band-logos/huggingface.svg?raw'
import linux from '../assets/band-logos/linux.svg?raw'
import netlify from '../assets/band-logos/netlify.svg?raw'
import next from '../assets/band-logos/next.svg?raw'
import nodejs from '../assets/band-logos/nodejs.svg?raw'
import ollama from '../assets/band-logos/ollama.svg?raw'
import openai from '../assets/band-logos/openai.svg?raw'
import postgresql from '../assets/band-logos/postgresql.svg?raw'
import python from '../assets/band-logos/python.svg?raw'
import react from '../assets/band-logos/react.svg?raw'
import rust from '../assets/band-logos/rust.svg?raw'
import threejs from '../assets/band-logos/threejs.svg?raw'
import typescript from '../assets/band-logos/typescript.svg?raw'
import vercel from '../assets/band-logos/vercel.svg?raw'
import vuejs from '../assets/band-logos/vuejs.svg?raw'
import webassembly from '../assets/band-logos/webassembly.svg?raw'

const words = [
  'ai agents',
  'retrieval',
  'evals',
  'tool calling',
  'fine-tuning',
  'developer tooling',
  'architecture',
  'api',
  'database',
  'observability',
  'performance',
  'type safety',
  'shipping',
]

// Alternates the general stack with the AI tooling so neither clumps together.
// Each SVG's viewBox is cropped to the logo's real outline, and `size` scales its height (1 = a
// square logo) so every logo covers about the same area, scaled down for solid shapes (TypeScript,
// WebAssembly) and up for thin line drawings (Netlify, Three.js) so they look equally heavy.
// `nudge` moves a logo down (or up, if negative) by a fraction of its height, for optical centring:
// logos whose weight sits low (Vercel's triangle, Docker's whale) look low when their box is
// centred, and top-heavy ones (Vue's V, the Astro rocket) look high. Each is moved half the distance
// between its box centre and its centre of mass.
const logos: { name: string; svg: string; size: number; nudge?: number }[] = [
  { name: 'typescript', svg: typescript, size: 0.97 },
  { name: 'openai', svg: openai, size: 1.04 },
  { name: 'python', svg: python, size: 0.93 },
  { name: 'anthropic', svg: anthropic, size: 0.83 },
  { name: 'react', svg: react, size: 1.01 },
  { name: 'huggingface', svg: huggingface, size: 0.89 },
  { name: 'nodejs', svg: nodejs, size: 1.13 },
  { name: 'ollama', svg: ollama, size: 1.15, nudge: 0.038 },
  { name: 'webassembly', svg: webassembly, size: 0.88 },
  { name: 'postgresql', svg: postgresql, size: 1.17, nudge: 0.033 },
  { name: 'docker', svg: docker, size: 0.83, nudge: -0.038 },
  { name: 'rust', svg: rust, size: 1.06 },
  { name: 'graphql', svg: graphql, size: 1.15 },
  { name: 'c', svg: c, size: 1.0 },
  { name: 'vuejs', svg: vuejs, size: 0.99, nudge: 0.057 },
  { name: 'linux', svg: linux, size: 1.27, nudge: 0.016 },
  { name: 'threejs', svg: threejs, size: 1.16, nudge: 0.036 },
  { name: 'next', svg: next, size: 1.08 },
  { name: 'vercel', svg: vercel, size: 0.92, nudge: -0.081 },
  { name: 'git', svg: git, size: 1.08 },
  { name: 'netlify', svg: netlify, size: 1.08 },
  { name: 'astro', svg: astro, size: 1.14, nudge: 0.05 },
]
---

<div class="wrapper" aria-hidden="true">
  <div class="text-scroll">
    {
      [...words, ...words].map((word) => (
        <span class="text-item">
          {word}
          <span class="sep" />
        </span>
      ))
    }
  </div>
  <div class="tech-logos">
    {
      [...logos, ...logos].map(({ name, svg, size, nudge = 0 }) => (
        <span class={`logo ${name}`} style={`--size: ${size}; --nudge: ${nudge}`} set:html={svg} />
      ))
    }
  </div>
  <div class="text-scroll">
    {
      [...words, ...words].reverse().map((word) => (
        <span class="text-item">
          {word}
          <span class="sep" />
        </span>
      ))
    }
  </div>
</div>

<style lang="scss">
  .wrapper {
    width: 100%;
    padding: 2rem 0;
    overflow-x: clip;
    position: relative;
    user-select: none;

    // Soft fade at both edges so rows slide in and out instead of being cut off. Overlays rather than
    // mask-image, because a mask would also clip the Astro rocket once it flies out of the band.
    &::before,
    &::after {
      content: '';
      position: absolute;
      top: 0;
      bottom: 0;
      width: 10%;
      z-index: 1;
      pointer-events: none;
      transition: background var(--theme-transition);
    }

    &::before {
      left: 0;
      background: linear-gradient(to right, var(--background), transparent);
    }

    &::after {
      right: 0;
      background: linear-gradient(to left, var(--background), transparent);
    }

    .text-scroll {
      display: flex;
      width: fit-content;
      white-space: nowrap;
      text-transform: uppercase;
      font-size: 3rem;
      font-weight: 300;
      letter-spacing: 4px;
      color: var(--text);
      transition: color var(--theme-transition);

      // The global span colour rule would otherwise override the row colour below
      .text-item {
        color: inherit;
      }

      &:first-of-type {
        animation: slide 60s linear infinite;
      }

      // Second row drifts the other way and steps back, so the band has some depth
      &:last-of-type {
        animation: slide 75s linear infinite reverse;
        color: color-mix(in srgb, var(--text) 35%, transparent);
      }
    }

    // Drawn as a circle: the site font's middle-dot glyph is square
    .sep {
      display: inline-block;
      width: 0.14em;
      height: 0.14em;
      margin: 0 0.7em;
      vertical-align: middle;
      border-radius: 50%;
      background-color: var(--accent);
    }

    .tech-logos {
      --gap: 3.5rem;
      // Height of a square logo; each logo scales it by its own --size
      --logo-size: 2.5rem;
      display: flex;
      align-items: center;
      gap: var(--gap);
      width: fit-content;
      padding: 1.5rem var(--gap) 1.5rem 0;
      color: var(--text);
      // Duration grows with the logo count so the scroll speed stays the same
      animation: slide 66s linear infinite;
    }

    .logo {
      flex-shrink: 0;
      display: inline-flex;
      height: calc(var(--logo-size) * var(--size, 1));
      // `top` rather than a transform, so it doesn't fight the rocket's launch animation
      position: relative;
      top: calc(var(--logo-size) * var(--size, 1) * var(--nudge, 0));
      opacity: 0.85;
      transition: opacity 0.2s ease;

      &:hover {
        opacity: 1;
      }

      :global(svg) {
        height: 100%;
        width: auto;
        display: block;
      }
    }

    // Easter egg: click the Astro logo to launch every Astro rocket. It flies off, then lands back
    // in its slot (see the script below), so it can be launched again.
    .astro {
      cursor: pointer;

      // The flame is the first path. It flickers from its top edge, where it meets the rocket.
      :global(path:first-of-type) {
        transform-box: fill-box;
        transform-origin: 50% 0%;
      }

      // Engine on: Astro's brand gradient (defined inside astro.svg) plus a flicker
      &:hover,
      &.launch,
      &.landing {
        :global(path:first-of-type) {
          fill: url(#astro-flame);
          animation: flameFlicker 0.12s ease-in-out infinite alternate;
        }
      }

      // Idle rumble on hover hints that something is about to happen
      &:hover:not(.launch):not(.landing) {
        animation: idleRumble 0.1s linear infinite;
      }

      &.launch {
        animation:
          launch 4s cubic-bezier(0.8, 0, 0.42, 0.42) 0.2s forwards,
          horizontalShaking 1s ease-out;
        animation-composition: add;
      }

      &.landing {
        animation: land var(--land-duration, 1.8s) cubic-bezier(0.22, 0.8, 0.3, 1) forwards;
      }
    }
  }

  @keyframes flameFlicker {
    from {
      transform: scaleY(0.82) scaleX(0.95);
    }
    to {
      transform: scaleY(1.12) scaleX(1.03);
    }
  }

  @keyframes idleRumble {
    0%,
    100% {
      transform: translate(0, 0);
    }
    25% {
      transform: translate(0.6px, -0.4px);
    }
    50% {
      transform: translate(-0.5px, 0.4px);
    }
    75% {
      transform: translate(0.4px, 0.5px);
    }
  }

  // Comes down from above the screen, overshoots a touch, and settles
  @keyframes land {
    0% {
      // Set from the script so the descent starts just above the top of the screen
      transform: translateY(calc(-1 * var(--landing-distance, 110vh)));
    }
    75% {
      transform: translateY(4px);
    }
    88% {
      transform: translateY(-3px);
    }
    100% {
      transform: translateY(0);
    }
  }

  @keyframes slide {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  @keyframes launch {
    0% {
      transform: translateY(0);
    }
    100% {
      transform: translateY(-300vh);
    }
  }

  @keyframes horizontalShaking {
    0% {
      transform: translateX(0);
    }
    15% {
      transform: translateX(3px);
    }
    30% {
      transform: translateX(-4px);
    }
    45% {
      transform: translateX(3px);
    }
    60% {
      transform: translateX(-3px);
    }
    75% {
      transform: translateX(4px);
    }
    90% {
      transform: translateX(-2px);
    }
    100% {
      transform: translateX(0);
    }
  }

  @media (max-width: 480px) {
    .wrapper {
      .text-scroll {
        font-size: 2rem;
      }

      .tech-logos {
        --gap: 2rem;
        --logo-size: 1.8rem;
        padding: 1rem var(--gap) 1rem 0;
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wrapper .text-scroll,
    .wrapper .tech-logos {
      animation: none;
    }

    .wrapper .astro:hover:not(.launch):not(.landing),
    .wrapper .astro :global(path:first-of-type) {
      animation: none !important;
    }
  }
</style>

<script>
  // Astro rocket easter egg: launch → pause off-screen → land back in the band.
  const astroLogos = document.querySelectorAll<HTMLElement>('.tech-logos .astro')
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)')
  const PAUSE_BEFORE_LANDING_MS = 1200

  // Both copies of the Astro logo launch together; a new launch waits until every one is back
  let rocketsInFlight = 0

  function isOnScreen(rect: DOMRect) {
    return rect.bottom > 0 && rect.top < window.innerHeight && rect.right > 0 && rect.left < window.innerWidth
  }

  // One smoke puff at (x, y) in viewport coordinates, drifting by (dx, dy) as it grows and fades.
  function puff(x: number, y: number, dx: number, dy: number) {
    const size = 8 + Math.random() * 10
    const el = document.createElement('span')
    el.setAttribute('aria-hidden', 'true')
    Object.assign(el.style, {
      position: 'fixed',
      left: `${x - size / 2}px`,
      top: `${y - size / 2}px`,
      width: `${size}px`,
      height: `${size}px`,
      borderRadius: '50%',
      background: 'color-mix(in srgb, var(--text) 30%, transparent)',
      pointerEvents: 'none',
      zIndex: '2',
    })
    document.body.append(el)
    el.animate(
      [
        { transform: 'translate(0, 0) scale(0.4)', opacity: 0.8 },
        { transform: `translate(${dx}px, ${dy}px) scale(2.2)`, opacity: 0 },
      ],
      { duration: 700 + Math.random() * 500, easing: 'cubic-bezier(0.2, 0.6, 0.4, 1)' }
    ).finished.then(() => el.remove())
  }

  // Where the bottom of the flame is right now
  function exhaustPoint(logo: HTMLElement) {
    const rect = logo.getBoundingClientRect()
    return { rect, x: rect.left + rect.width / 2, y: rect.bottom }
  }

  // A cloud of puffs spreading sideways, for ignition and touchdown
  function dustBurst(logo: HTMLElement, count: number) {
    const { rect, x, y } = exhaustPoint(logo)
    if (!isOnScreen(rect)) return
    for (let i = 0; i < count; i++) {
      const side = i % 2 === 0 ? 1 : -1
      puff(x, y - 4, side * (20 + Math.random() * 30), -4 - Math.random() * 10)
    }
  }

  // Smoke trail left behind while the rocket climbs; stops once it has left the screen
  function smokeTrail(logo: HTMLElement) {
    const interval = setInterval(() => {
      const { rect, x, y } = exhaustPoint(logo)
      if (!logo.classList.contains('launch') || rect.bottom < 0) {
        clearInterval(interval)
        return
      }
      if (isOnScreen(rect)) puff(x + (Math.random() - 0.5) * 6, y, (Math.random() - 0.5) * 24, 25 + Math.random() * 30)
    }, 45)
  }

  function land(logo: HTMLElement) {
    stopScrollCompensation.get(logo)?.()
    stopScrollCompensation.delete(logo)
    logo.classList.remove('launch')

    // Where the rocket's slot in the band is right now (measured before the next paint, so no flash)
    const slot = logo.getBoundingClientRect()
    if (!isOnScreen(slot)) {
      // The reader can't see the band: just put the rocket back
      rocketsInFlight--
      return
    }

    // Start the descent just above the top of the screen, and keep the original landing speed
    const distance = slot.bottom + 40
    const seconds = Math.max(1, (1.8 * distance) / (1.1 * window.innerHeight))
    logo.style.setProperty('--landing-distance', `${distance}px`)
    logo.style.setProperty('--land-duration', `${seconds}s`)
    logo.classList.add('landing')
    logo.addEventListener('animationend', function onLanded(event) {
      if (event.animationName !== 'land') return
      logo.removeEventListener('animationend', onLanded)
      logo.classList.remove('landing')
      if (!reducedMotion.matches) dustBurst(logo, 6)
      rocketsInFlight--
    })
  }

  // The flight is relative to the band, so scrolling up would bring the band (and the rocket) back
  // down into view, and the rocket would look stuck mid-page. While it's in the air, any upward scroll
  // is cancelled out with the `translate` property (which stacks with the animated `transform`), so
  // the rocket keeps climbing out of the top of the screen however the reader scrolls.
  const stopScrollCompensation = new Map<HTMLElement, () => void>()

  function compensateScroll(logo: HTMLElement) {
    const startScrollY = window.scrollY
    const onScroll = () => {
      const scrolledUp = Math.max(0, startScrollY - window.scrollY)
      logo.style.translate = scrolledUp ? `0 ${-scrolledUp}px` : ''
    }
    window.addEventListener('scroll', onScroll, { passive: true })
    stopScrollCompensation.set(logo, () => {
      window.removeEventListener('scroll', onScroll)
      logo.style.translate = ''
    })
  }

  function launch(logo: HTMLElement) {
    compensateScroll(logo)
    logo.classList.add('launch')
    if (!reducedMotion.matches) {
      dustBurst(logo, 8)
      smokeTrail(logo)
    }
    logo.addEventListener('animationend', function onLaunched(event) {
      if (event.animationName !== 'launch') return
      logo.removeEventListener('animationend', onLaunched)
      setTimeout(() => land(logo), PAUSE_BEFORE_LANDING_MS)
    })
  }

  astroLogos.forEach((astroLogo) => {
    astroLogo.addEventListener('click', () => {
      // Ignore clicks while a flight is under way
      if (rocketsInFlight > 0) return
      rocketsInFlight = astroLogos.length
      astroLogos.forEach(launch)
    })
  })
</script>
